# ============================================================================
# AWS Deployment Environment Configuration (Optional for Local Dev)
# ============================================================================

# Server Port & Environment
PORT=8000
ENVIRONMENT=development

# Database: Set DATABASE_URL for Amazon RDS PostgreSQL.
# Leave empty or omit to automatically use local SQLite (traffic_system.db)
# DATABASE_URL=postgresql://postgres:YourPassword@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/trafficdb

# AWS IoT Core (MQTT Broker on Port 8883)
# Leave empty for internal local event bus
# AWS_IOT_ENDPOINT=a1b2c3d4e5f6-ats.iot.ap-south-1.amazonaws.com
# AWS_IOT_PORT=8883
# AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
# AWS_IOT_CERT_PATH=certs/backend.cert.pem
# AWS_IOT_KEY_PATH=certs/backend.private.key

# Amazon Cognito (Role-Based Authentication)
# COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=ap-south-1

# Amazon S3 (Edge frame storage & export logs)
# S3_BUCKET_NAME=ambulance-priority-artifacts
